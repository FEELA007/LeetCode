class Solution {
    public void reverseString(char[] s) {
        int f=0;
        int l=s.length-1;
        for(int i=0;i<s.length;i++){
            if(f<l){
                char temp=s[l];
                s[l]=s[f];
                s[f]=temp;
                f++;
                l--;
            }
        }
        
    }
}