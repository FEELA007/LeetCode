class Solution {
    public int differenceOfSums(int n, int m) {
        int sumd=0;
        int sumf=0;
        for(int i=1;i<n+1;i++){
            if(i%m==0){
                sumd+=i;
            }
            else{
                sumf+=i;
            }
        }
        return sumf-sumd;
    }
}