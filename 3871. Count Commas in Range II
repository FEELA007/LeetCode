class Solution {
    public long countCommas(long n) {
        long ans = 0;

        if (n >= 1_000)
            ans += n - 999;

        if (n >= 1_000_000)
            ans += n - 999_999;

        if (n >= 1_000_000_000L)
            ans += n - 999_999_999L;

        if (n >= 1_000_000_000_000L)
            ans += n - 999_999_999_999L;

        if (n >= 1_000_000_000_000_000L)
            ans += n - 999_999_999_999_999L;

        return ans;
    }
}
